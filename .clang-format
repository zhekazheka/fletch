---
BasedOnStyle: LLVM
BreakBeforeBraces: Allman
Standard: Latest
IndentWidth: 4
NamespaceIndentation: All
ColumnLimit: 100
PointerAlignment: Left
QualifierAlignment: Left
AllowShortFunctionsOnASingleLine: Empty
InsertBraces: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<catch2/'
    Priority: 3
  - Regex: '^"'
    Priority: 1
  - Regex: '^<.*\.h>'
    Priority: 4
  - Regex: '^<'
    Priority: 2
